@startuml brigade-service

skinparam monochrome true
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam classFontSize 10
skinparam packageFontSize 11
left to right direction

title Диаграмма классов brigade-service

package "api" {
    class ServerBuilder {
        - server: goserver.Server
        - router: *gorouter.Router
        --
        + AddBrigades(service)
        + Build(): goserver.Server
    }

    class BrigadeHandler <<functions>> {
        + CreateBrigade(s): Handler
        + GetBrigadeByID(s): Handler
        + GetAllBrigades(s): Handler
    }
}

package "service/brigade" {
    class Service {
        - repository: Repository
        - userService: UserService
        --
        + CreateBrigade(ctx, req): Brigade
        + GetBrigadeByID(ctx, id): Brigade
        + GetAllBrigades(ctx): []Brigade
        + SubscriberOnTaskEvent(): Subscriber
    }

    interface Repository <<interface>> {
        + CreateBrigade(ctx, inspectors): Brigade
        + GetBrigadeByID(ctx, id): Brigade
        + GetAllBrigades(ctx): []Brigade
        + UpdateBrigadeStatus(ctx, id, status)
    }

    interface UserService <<interface>> {
        + GetUsersByIDs(ctx, ids): []User
    }

    class Brigade {
        + ID: int
        + Status: Status
        + Inspectors: []Inspector
        + CreatedAt, UpdatedAt: time.Time
    }

    class Inspector {
        + ID: int
        + Surname, Name, Patronymic: string
        + PhoneNumber, Email: string
        + AssignedAt: time.Time
    }

    enum Status {
        Idle, OnTask, Archived
    }
}

package "database/brigade" {
    class RepositoryImpl {
        - db: *sqlx.DB
        --
        + CreateBrigade()
        + GetBrigadeByID()
        + GetAllBrigades()
        + UpdateBrigadeStatus()
    }

    class DBBrigade <<entity>> {
        + ID, Status: int
        + CreatedAt, UpdatedAt: time.Time
    }

    class Member <<entity>> {
        + BrigadeID, InspectorID: int
        + AssignedAt: time.Time
    }
}

package "cluster" {
    class UserClient {
        - client: gohttp.Client
        - baseURL: string
        --
        + GetUsersByIDs(ctx, ids): []User
    }

    class User {
        + ID: int
        + Role: Role
        + Surname, Name: string
        + PhoneNumber, Email: string
    }

    class Event {
        + Type: EventType
        + Task: Task
    }

    class Task {
        + ID: int
        + BrigadeID: *int
        + Status: TaskStatus
    }

    enum Role {
        Inspector, Dispatcher, Specialist
    }

    enum EventType {
        Add, Start, Finish
    }
}

ServerBuilder --> BrigadeHandler
BrigadeHandler --> Service

Service ..|> Repository : uses
Service ..|> UserService : uses
Service --> Brigade : returns
Service --> Event : handles

RepositoryImpl ..|> Repository : implements
RepositoryImpl --> DBBrigade
RepositoryImpl --> Member

UserClient ..|> UserService : implements
UserClient --> User

Brigade --> Inspector : contains
Brigade --> Status
Inspector ..> User : mapped from

Event --> Task

@enduml
